# Data source: "mock" (default, in-browser demo data) or "api" (Bill-Z backend)
VITE_DATA_SOURCE=mock
# API base URL. Keep /api/v1 to use the Vite dev proxy below.
VITE_API_URL=/api/v1
# Where the dev server proxies /api (the backend's PORT)
VITE_API_PROXY_TARGET=http://localhost:5000
# Show the demo account shortcuts on the sign-in screen in API mode (dev/staging only)
VITE_SHOW_DEMO_LOGINS=true
# Must match the backend's DEMO_OTP_CODE
VITE_DEMO_OTP_CODE=482916
