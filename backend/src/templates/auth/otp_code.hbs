<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Your Bill-Z verification code</title>
  </head>
  <body
    style='margin:0;padding:0;background-color:#F6F8FB;font-family:Inter,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#172033;'
  >
    <table
      role='presentation'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='padding:32px 16px;'
    >
      <tr>
        <td align='center'>
          <table
            role='presentation'
            width='480'
            cellpadding='0'
            cellspacing='0'
            style='max-width:480px;width:100%;background:#FFFFFF;border:1px solid #E4E7EC;border-radius:16px;'
          >
            <tr>
              <td style='padding:32px;'>
                <p
                  style='margin:0 0 8px;font-size:20px;font-weight:700;color:#183153;'
                >{{appName}}</p>
                <p style='margin:0 0 24px;font-size:15px;color:#667085;'>Hi
                  {{name}}, use this code to sign in.</p>
                <p
                  style='margin:0 0 24px;font-size:32px;font-weight:700;letter-spacing:8px;color:#172033;'
                >{{code}}</p>
                <p style='margin:0 0 8px;font-size:14px;color:#667085;'>The code is valid for
                  {{expiresInMinutes}}
                  minutes and can be used once.</p>
                <p style='margin:0;font-size:14px;color:#667085;'>For your security, never share
                  this code with anyone. If you didn’t request it, you can ignore this email.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>